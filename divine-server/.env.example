# Copy to .env and fill in your DeepSeek key to use real streaming.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# auto uses DeepSeek when a key exists, otherwise a local demo agent.
AI_PROVIDER=auto

# GLM vision model for read_image tool
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-4.6v-flash

WORKSPACE_DIR=./workspace
DB_PATH=./data/ai_divine.db
HOST=127.0.0.1
PORT=8019
CORS_ORIGINS=http://localhost:8010,http://127.0.0.1:8010,tauri://localhost,http://tauri.localhost,https://tauri.localhost
