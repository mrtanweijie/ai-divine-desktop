# Copy to .env and fill in your DeepSeek key to use real streaming.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# auto uses DeepSeek when a key exists, otherwise a local demo agent.
AI_PROVIDER=auto

WORKSPACE_DIR=./workspace
DB_PATH=./data/ai_divine.db
HOST=127.0.0.1
PORT=8010
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
