{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://divine.local/schemas/graph-ir.schema.json",
  "title": "GraphIR",
  "description": "Declarative graph description for the render_graph tool. Carries topology and semantics only: no coordinates, no colours, no shapes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "nodes"
  ],
  "properties": {
    "kind": {
      "enum": [
        "flow",
        "dag",
        "dataflow",
        "state",
        "org",
        "mindmap",
        "topology",
        "arch",
        "er",
        "swimlane",
        "sequence",
        "concept",
        "class",
        "fishbone",
        "timeline"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "summary": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 150,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-.:]{1,64}$"
          },
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "role": {
            "enum": [
              "start",
              "end",
              "process",
              "decision",
              "data",
              "entity",
              "state",
              "milestone",
              "member"
            ]
          },
          "tone": {
            "enum": [
              "neutral",
              "info",
              "success",
              "warning",
              "error"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          },
          "badge": {
            "type": "string",
            "maxLength": 12
          },
          "state": {
            "enum": [
              "pending",
              "running",
              "success",
              "failed"
            ]
          },
          "icon": {
            "enum": [
              "code",
              "box",
              "check",
              "flask",
              "stack",
              "layers",
              "upload",
              "gear",
              "INPUT",
              "FILTER",
              "JOIN",
              "UNION",
              "AGG",
              "OUTPUT"
            ]
          },
          "pseudo": {
            "enum": [
              "initial",
              "final",
              "choice"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "role_desc": {
            "type": "string",
            "maxLength": 40
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "enum": [
              "module",
              "tech",
              "data",
              "process",
              "concept",
              "external",
              "security",
              "cloud",
              "backend",
              "database",
              "messagebus"
            ]
          },
          "category": {
            "type": "string",
            "maxLength": 20
          },
          "sublabel": {
            "type": "string",
            "maxLength": 40
          },
          "tag": {
            "type": "string",
            "maxLength": 16
          },
          "lane": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "kind": {
            "enum": [
              "flow",
              "dep",
              "transit",
              "inherit",
              "assoc",
              "contain"
            ]
          },
          "tone": {
            "enum": [
              "neutral",
              "info",
              "success",
              "warning",
              "error"
            ]
          },
          "style": {
            "enum": [
              "solid",
              "dashed",
              "dotted"
            ]
          },
          "flow": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "antline",
                  "pulse"
                ]
              },
              "tone": {
                "enum": [
                  "neutral",
                  "info",
                  "success",
                  "warning",
                  "error"
                ]
              },
              "speed": {
                "enum": [
                  0.5,
                  1.0,
                  2.0
                ]
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-.:]{1,64}$"
          },
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "type": {
            "enum": [
              "lane",
              "cluster",
              "combo",
              "region",
              "vpc",
              "security-group"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "demoPath": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "string"
      }
    }
  }
}
