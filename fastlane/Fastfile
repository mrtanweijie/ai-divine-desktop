require 'etc'
require 'plist'
require 'base64'
require 'tmpdir'
require 'fileutils'
require 'securerandom'

default_platform(:mac)

# ============================================================================
# ai-divine-desktop —— Tauri 2 桌面端（Vite/React + Python FastAPI sidecar）。
#
# 只做 Developer ID 直装分发（不上 Mac App Store —— 本应用需下载/执行
# divine-server 子进程，与 App Store 沙盒不兼容）。
#
#   mac dmg : tauri build --no-sign 出 arm64 + x86_64 两套 .app，
#             lipo 合并成 universal → codesign Developer ID Application
#             (Hardened Runtime) + notarytool 公证 + staple，产出可直装
#             universal DMG（一份包同时支持 Apple Silicon 与 Intel Mac）。
#
# 签名素材存放在 ios-sign 仓库（与其它项目共用），CI 通过 MATCH_* secrets 拉取解密：
#   certs/developer_id/*.p12   Developer ID Application（DMG 直装分发签名）
#
# 与 gitea-runner-manager-macos 的 Fastfile 区别：
#   - 不用 xcodebuild；改用 pnpm exec tauri build --no-sign 出 .app
#   - 双架构分别出 .app 后用 `lipo -create` 合并主二进制（与 .app 内的 sidecar）
#   - lipo 后用 hdiutil 重新打一份 universal DMG（不依赖 Tauri 的 DMG）
#   - codesign 顺序：sidecar → .app 内 dylib（深度倒序）→ .app 整体 → .dmg
#   - killall XCBBuildService / xcodebuild → killall codesign（Tauri 不用 Xcode）
# ============================================================================

APP_NAME         = "Divine"
APP_DISPLAY_NAME = "Divine"
APP_BUNDLE_ID    = "com.ai-divine.desktop"
# TEAM_ID 不需要：
#   - Developer ID 直装分发不走 App Store，codesign + notarytool 都不强校 team id
#   - 我们也未用 xcodebuild / gym / exportArchive，无需 team 给 export method
#   - 强行加只会因为缺 secret 而失败。

PROJECT_ROOT = File.expand_path("..", __dir__)
TAURI_DIR    = File.join(PROJECT_ROOT, "divine-app")
SIDECAR_DIR  = File.join(PROJECT_ROOT, "divine-server")
BUILD_DIR    = File.join(PROJECT_ROOT, "build")
ENTITLEMENTS = File.join(TAURI_DIR, "src-tauri", "Entitlements.plist")

# Tauri 在 --no-sign 下产物路径约定。
TAURI_TARGET_DIR    = File.join(TAURI_DIR, "src-tauri", "target", "release", "bundle")
TAURI_APP_PATH      = File.join(TAURI_TARGET_DIR, "macos",    "#{APP_NAME}.app")
TAURI_DMG_DIR       = File.join(TAURI_TARGET_DIR, "dmg")

# 从 ios-sign 仓库拉取 Developer ID Application 证书，导入到独立 build keychain。
# 返回 Developer ID 证书 SHA-1 与 keychain 路径，供 codesign / notarytool 使用。
def macos_install_developer_id_signing!
  UI.user_error!("MATCH_PASSWORD is not set or empty!") if ENV['MATCH_PASSWORD'].nil? || ENV['MATCH_PASSWORD'].empty?

  git_url = ENV["MATCH_GIT_URL"] || "https://git.duguying.net/duguying/ios-sign.git"
  if ENV["MATCH_GIT_BASIC_AUTHORIZATION"] && !ENV["MATCH_GIT_BASIC_AUTHORIZATION"].empty?
    auth = Base64.decode64(ENV["MATCH_GIT_BASIC_AUTHORIZATION"]).strip
    git_url = git_url.sub("https://", "https://#{auth}@")
  end

  certs_temp_dir = Dir.mktmpdir
  sh("GIT_TERMINAL_PROMPT=0 GIT_CONFIG_NOSYSTEM=1 " \
     "git -c http.sslVerify=false " \
     "-c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 " \
     "-c credential.helper= " \
     "clone --depth 1 --branch main #{git_url} #{certs_temp_dir}", log: false)

  developer_id_p12_files = Dir.glob("#{certs_temp_dir}/certs/developer_id/*.p12")
  UI.user_error!(
    "No Developer ID Application .p12 found under certs/developer_id/ in ios-sign repo. " \
    "请先把 Developer ID Application 的 .p12 加密存入该目录后再运行。"
  ) if developer_id_p12_files.empty?

  real_home = Etc.getpwuid(Process.uid).dir
  login_keychain_path = "#{real_home}/Library/Keychains/login.keychain-db"
  login_keychain_password = ENV['RUNNER_PASSWORD'] || ''

  ENV['HOME'] = real_home if ENV['CI'] && real_home != ENV['HOME']

  sh("security unlock-keychain -p '#{login_keychain_password}' '#{login_keychain_path}' 2>/dev/null || true")

  wwdr_dir = "#{certs_temp_dir}/wwdr"
  FileUtils.mkdir_p(wwdr_dir)
  sh("curl -sL -o '#{wwdr_dir}/AppleIncRootCertificate.cer' https://www.apple.com/appleca/AppleIncRootCertificate.cer")
  sh("curl -sL -o '#{wwdr_dir}/AppleWWDRCAG3.cer' https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer")
  sh("curl -sL -o '#{wwdr_dir}/AppleWWDRCAG6.cer' https://www.apple.com/certificateauthority/AppleWWDRCAG6.cer")
  # Developer ID 链需要 "Developer ID Certification Authority"（G2 子 CA）。
  sh("curl -sL -o '#{wwdr_dir}/DeveloperIDG2CA.cer' https://www.apple.com/certificateauthority/DeveloperIDG2CA.cer || true")

  build_keychain_password = "build_#{SecureRandom.hex(8)}"
  build_keychain_path = "#{real_home}/Library/Keychains/build.keychain-db"
  sh("security delete-keychain '#{build_keychain_path}' 2>/dev/null || true")
  sh("security create-keychain -p '#{build_keychain_password}' '#{build_keychain_path}'")
  sh("security set-keychain-settings -t 7200 -u '#{build_keychain_path}'")
  sh("security unlock-keychain -p '#{build_keychain_password}' '#{build_keychain_path}'")
  sh("security import '#{wwdr_dir}/AppleIncRootCertificate.cer' -k '#{build_keychain_path}' -A 2>/dev/null || true")
  sh("security import '#{wwdr_dir}/AppleWWDRCAG3.cer' -k '#{build_keychain_path}' -A 2>/dev/null || true")
  sh("security import '#{wwdr_dir}/AppleWWDRCAG6.cer' -k '#{build_keychain_path}' -A 2>/dev/null || true")
  sh("security import '#{wwdr_dir}/DeveloperIDG2CA.cer' -k '#{build_keychain_path}' -A 2>/dev/null || true")

  developer_id_p12 = developer_id_p12_files.first
  decrypted_developer_id_p12 = "#{certs_temp_dir}/decrypted_developer_id.p12"
  raw_devid = File.binread(developer_id_p12)
  if raw_devid[0..7] == "U2FsdGVk"
    sh("echo '#{ENV['MATCH_PASSWORD']}' | openssl enc -aes-256-cbc -a -d -md md5 -pass stdin -in '#{developer_id_p12}' -out '#{decrypted_developer_id_p12}'", log: false)
  else
    sh("echo '#{ENV['MATCH_PASSWORD']}' | openssl enc -aes-256-cbc -d -md md5 -pass stdin -in '#{developer_id_p12}' -out '#{decrypted_developer_id_p12}'", log: false)
  end
  sh("security import '#{decrypted_developer_id_p12}' -k '#{build_keychain_path}' -P '#{ENV['MATCH_PASSWORD']}' -A")
  UI.success "Imported Developer ID Application cert: #{File.basename(developer_id_p12)}"

  sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '#{build_keychain_password}' '#{build_keychain_path}'")
  sh("security default-keychain -d user -s '#{build_keychain_path}'")
  all_keychains = "'#{build_keychain_path}' '#{login_keychain_path}' /Library/Keychains/System.keychain /System/Library/Keychains/SystemRootCertificates.keychain"
  sh("security list-keychains -d user -s #{all_keychains}")

  valid_identities_out = sh("security find-identity -v -p codesigning '#{build_keychain_path}' 2>&1 || true", log: false)
  devid_match = valid_identities_out.match(/([A-F0-9]{40})\s+"Developer ID Application/)
  developer_id_cert_sha1 = devid_match ? devid_match[1] : ""
  UI.user_error!(
    "Developer ID Application 证书导入后未在 keychain 中找到有效身份。"
  ) if developer_id_cert_sha1.empty?
  UI.message "Developer ID Application cert SHA-1: #{developer_id_cert_sha1}"

  FileUtils.rm_rf(certs_temp_dir)
  # Tauri 不用 Xcode Build Service，只清理 codesign helper 进程避免 stale 状态。
  sh("killall codesign 2>/dev/null || true")
  sleep(2)

  { keychain_path: build_keychain_path, developer_id_cert_sha1: developer_id_cert_sha1, real_home: real_home }
end

# 从 tauri build --target <triple> 推断 PyInstaller sidecar 目标。
# （保留以便按需单架构构建；universal lane 直接硬编码 darwin-arm64 / darwin-x64。）
def sidecar_target_from_rust_target(rust_target)
  case rust_target
  when "aarch64-apple-darwin" then "darwin-arm64"
  when "x86_64-apple-darwin"  then "darwin-x64"
  else UI.user_error!("Unsupported rust target for sidecar: #{rust_target}")
  end
end

platform :mac do
  before_all do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "10"
  end

  desc "Build Developer ID signed + notarized universal DMG for direct distribution (Tauri, arm64 + x86_64)"
  lane :dmg do
    ensure_git_status_clean unless ENV["CI"]

    signing = macos_install_developer_id_signing!
    keychain_path = signing[:keychain_path]
    dev_id_sha1   = signing[:developer_id_cert_sha1]

    FileUtils.mkdir_p(BUILD_DIR)
    ENV['CI'] = 'true'

    # ---- 1. 构建双架构 sidecar ----
    # CI 环境下显式指定 PYTHON（指向 brew 的 python@3.11），避免 build-sidecar.sh
    # 退化到 /usr/bin/python3（macOS 自带 3.9，不够新，PyInstaller spec 用了 3.10+ 语法）。
    sidecar_python = ENV["PYTHON"] || "#{`brew --prefix python@3.11 2>/dev/null`.strip}/bin/python3.11"
    sidecar_python = "/usr/bin/python3" if sidecar_python.nil? || sidecar_python.empty?
    ENV["PYTHON"] = sidecar_python
    UI.message "Using PYTHON=#{sidecar_python} for sidecar builds"

    UI.message "Building divine-server sidecar for darwin-arm64..."
    sh("bash '#{File.join(SIDECAR_DIR, 'build-sidecar.sh')}' darwin-arm64")
    UI.message "Building divine-server sidecar for darwin-x64..."
    sh("bash '#{File.join(SIDECAR_DIR, 'build-sidecar.sh')}' darwin-x64")

    # ---- 2. 双架构 tauri build --no-sign ----
    # 必须分别指定 --target aarch64/x86_64-apple-darwin，让 cargo 编出两个
    # 独立的 target/release 子目录；之后用 lipo 合并出 universal。
    UI.message "Running: pnpm exec tauri build for aarch64-apple-darwin..."
    sh(
      "cd '#{TAURI_DIR}' && " \
      "pnpm install --frozen-lockfile && " \
      "pnpm exec tauri build --no-sign " \
      "--target aarch64-apple-darwin " \
      "--config src-tauri/tauri.prod.conf.json " \
      "--bundles app"
      # 注意：只产 .app，不让 Tauri 提前打 DMG（lipo 后我们要重新打一次）。
    )

    UI.message "Running: pnpm exec tauri build for x86_64-apple-darwin..."
    sh(
      "cd '#{TAURI_DIR}' && " \
      "pnpm exec tauri build --no-sign " \
      "--target x86_64-apple-darwin " \
      "--config src-tauri/tauri.prod.conf.json " \
      "--bundles app"
    )

    # ---- 3. 定位两套产物 ----
    arm64_app = File.join(TAURI_DIR, "src-tauri", "target", "aarch64-apple-darwin", "release", "bundle", "macos", "#{APP_NAME}.app")
    x64_app   = File.join(TAURI_DIR, "src-tauri", "target", "x86_64-apple-darwin",  "release", "bundle", "macos", "#{APP_NAME}.app")
    UI.user_error!("arm64 .app not found at #{arm64_app}") unless File.directory?(arm64_app)
    UI.user_error!("x64   .app not found at #{x64_app}")   unless File.directory?(x64_app)

    arm64_main = File.join(arm64_app, "Contents", "MacOS", APP_NAME)
    x64_main   = File.join(x64_app,   "Contents", "MacOS", APP_NAME)
    UI.user_error!("arm64 main binary not found") unless File.file?(arm64_main)
    UI.user_error!("x64   main binary not found") unless File.file?(x64_main)

    # Tauri 把 externalBin 拷进 .app/Contents/MacOS/divine-server（与主二进制同级，
    # 真实文件拷贝），而不是 _internal/。上一轮就是在 _internal/ 下探测不到导致
    # sidecar 没被 lipo，最终 DMG 里的 divine-server 是 arm64-only（Apple 公证日志
    # 里只有 arm64 一个 slice）——Intel Mac 上会直接起不来。src-tauri/binaries/ 下
    # 的带 triple 后缀文件才是 externalBin 的源。
    arm64_sidecar_app = File.join(arm64_app, "Contents", "MacOS", "divine-server")
    x64_sidecar_app   = File.join(x64_app,   "Contents", "MacOS", "divine-server")

    # ---- 4. lipo 合并主二进制 + sidecar ----
    # 4a) 主二进制 Divine
    UI.message "lipo: combining main binary Divine (arm64 + x86_64)..."
    FileUtils.mv(arm64_main, "#{arm64_main}.arm64")
    FileUtils.mv(x64_main,   "#{arm64_main}.x64")
    sh("/usr/bin/lipo -create -output '#{arm64_main}' '#{arm64_main}.arm64' '#{arm64_main}.x64'")
    FileUtils.rm_f(["#{arm64_main}.arm64", "#{arm64_main}.x64"])
    sh("/usr/bin/lipo -info '#{arm64_main}'")

    # 4b) sidecar 同样 lipo 成 universal（在 codesign 之前，保证打进 DMG 的是
    #     双架构版本）。若某个 target 没产出 sidecar（如外部依赖缺失），跳过。
    if File.file?(arm64_sidecar_app) && File.file?(x64_sidecar_app)
      UI.message "lipo: combining in-app sidecar..."
      FileUtils.mv(arm64_sidecar_app, "#{arm64_sidecar_app}.arm64")
      FileUtils.mv(x64_sidecar_app,   "#{arm64_sidecar_app}.x64")
      sh("/usr/bin/lipo -create -output '#{arm64_sidecar_app}' '#{arm64_sidecar_app}.arm64' '#{arm64_sidecar_app}.x64'")
      FileUtils.rm_f(["#{arm64_sidecar_app}.arm64", "#{arm64_sidecar_app}.x64"])
      sh("/usr/bin/lipo -info '#{arm64_sidecar_app}'")
    end

    # ---- 5. 完整 codesign 链路（顺序：sidecar → 内部 dylib → .app） ----
    # 必须在打 DMG 之前完成：DMG 里的 .app 是 staging 的 cp_r 副本，只有先把
    # 源码树里的 .app 签好，拷进 DMG 的才是带 Developer ID + 时间戳 + 硬化运行时
    # 的签名版本。否则 notarization 会报 "not signed with valid Developer ID /
    # no secure timestamp / hardened runtime not enabled"（上一轮就是：DMG 先打、
    # .app 后签，导致 DMG 内嵌的是 linker 的 ad-hoc 签名）。
    # 5a) src-tauri/binaries/ 下的 externalBin 源（每个 triple 一份）。
    #     Tauri 在 macOS universal .app 里运行时实际不会用它们（它用 _internal/ 那份），
    #     但仍按规范签名以免 spctl/Gatekeeper 误报。
    Dir.glob(File.join(TAURI_DIR, "src-tauri", "binaries", "divine-server*"))
       .reject { |p| p.end_with?(".pdb") || File.directory?(p) }
       .each do |bin|
      UI.message "Codesigning sidecar: #{File.basename(bin)}"
      sh(
        "/usr/bin/codesign --force --sign '#{dev_id_sha1}' --keychain '#{keychain_path}' " \
        "--timestamp --options runtime '#{bin}'"
      )
    end

    # 5b) .app 内所有 dylib/framework（深度倒序：先叶子再父目录）。
    inner_dylibs     = Dir.glob(File.join(arm64_app, "**", "*.dylib")).sort
    inner_frameworks = Dir.glob(File.join(arm64_app, "**", "*.framework")).sort
    (inner_dylibs + inner_frameworks).each do |lib|
      sh(
        "/usr/bin/codesign --force --sign '#{dev_id_sha1}' --keychain '#{keychain_path}' " \
        "--timestamp --options runtime --deep '#{lib}'"
      )
    end

    # 5c) .app 整体（带 entitlements，硬化运行时）。
    sh(
      "/usr/bin/codesign --force --sign '#{dev_id_sha1}' --keychain '#{keychain_path}' " \
      "--timestamp --options runtime --entitlements '#{ENTITLEMENTS}' " \
      "--deep '#{arm64_app}'"
    )

    # ---- 6. 用已签名的 .app 重新打 DMG（不依赖 Tauri 自动打的版本） ----
    # 清掉 Tauri 自己出的 arm64-only DMG（如果有的话）。
    FileUtils.rm_rf(TAURI_DMG_DIR)

    staging = File.join(BUILD_DIR, "dmg_staging")
    FileUtils.rm_rf(staging)
    FileUtils.mkdir_p(staging)
    FileUtils.cp_r(arm64_app, staging)
    FileUtils.ln_s("/Applications", File.join(staging, "Applications"))
    staged_dmg = File.join(BUILD_DIR, "#{APP_DISPLAY_NAME}.dmg")
    FileUtils.rm_f(staged_dmg)
    sh("hdiutil create -volname '#{APP_DISPLAY_NAME}' -srcfolder '#{staging}' -ov -format UDZO '#{staged_dmg}'")
    FileUtils.rm_rf(staging)

    # ---- 7. .dmg 本身再签（带时间戳） ----
    sh(
      "/usr/bin/codesign --force --sign '#{dev_id_sha1}' --keychain '#{keychain_path}' " \
      "--timestamp '#{staged_dmg}'"
    )

    # ---- 8. 验证（早失败） ----
    sh("/usr/bin/codesign --verify --deep --strict --verbose=2 '#{arm64_app}'")
    sh("hdiutil verify '#{staged_dmg}'")
    sh("/usr/bin/lipo -info '#{arm64_main}'")  # 再次确认 universal
    # sidecar 必须也是 universal；4b 若因路径问题被跳过，这里直接报错而不是
    # 默默发一个 Intel 上跑不起来的"universal"包。
    sh("/usr/bin/lipo -info '#{arm64_sidecar_app}'")

    # ---- 9. 公证：App Store Connect API Key ----
    key_id      = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id   = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
    %w[APP_STORE_CONNECT_API_KEY_ID APP_STORE_CONNECT_API_KEY_ISSUER_ID APP_STORE_CONNECT_API_KEY_CONTENT].each do |k|
      UI.user_error!("#{k} not set (notarization needs ASC API key)") if ENV[k].nil? || ENV[k].empty?
    end

    notary_dir = Dir.mktmpdir
    p8_path = File.join(notary_dir, "AuthKey_#{key_id}.p8")
    File.write(p8_path, key_content)

    UI.message "Submitting DMG to Apple notary service (--wait, 可能需要几分钟)..."
    notary_output = `xcrun notarytool submit '#{staged_dmg}' --key '#{p8_path}' --key-id '#{key_id}' --issuer '#{issuer_id}' --wait 2>&1`
    UI.message(notary_output)

    submission_id = notary_output.match(/id:\s*([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/m)&.captures&.first
    # notarytool --wait 的轮询输出里 "Current status: In Progress..." 会重复多行，
    # 最后一行才是终态（Accepted / Invalid / Rejected）。必须取最后一个 status
    # 标记；取第一个会被 "In Progress" 的 "In" 骗到（上一轮就是：明明 Accepted，
    # 却误判为 status=In 而失败）。
    status = notary_output.scan(/status:\s*([A-Za-z]+)/).flatten.last

    unless status == "Accepted"
      if submission_id
        UI.error "Notarization status=#{status || 'unknown'} - fetching detailed log for #{submission_id}..."
        log_path = File.join(notary_dir, "notary_#{submission_id}.json")
        `xcrun notarytool log '#{submission_id}' --key '#{p8_path}' --key-id '#{key_id}' --issuer '#{issuer_id}' --output-format json '#{log_path}' 2>&1`
        UI.message(File.exist?(log_path) ? File.read(log_path) : "(notarytool log produced no output)")
      end
      FileUtils.rm_rf(notary_dir)
      UI.user_error!("Notarization failed: status=#{status || 'unknown'}")
    end

    UI.message "Stapling notarization ticket..."
    sh("xcrun stapler staple '#{staged_dmg}'")
    sh("xcrun stapler validate -v '#{staged_dmg}'")
    FileUtils.rm_rf(notary_dir)

    UI.success "Notarized universal DMG ready: #{staged_dmg}"
  end
end
