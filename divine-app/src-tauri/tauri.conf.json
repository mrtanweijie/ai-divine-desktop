{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Divine",
  "mainBinaryName": "Divine",
  "version": "0.1.0",
  "identifier": "com.ai-divine.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:8010",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Divine",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": { "x": 12, "y": 27 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:8019 https://api.deepseek.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/divine-server"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "localhost",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
