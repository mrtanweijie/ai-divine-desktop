{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Divine",
  "version": "0.1.0",
  "identifier": "com.ai-divine.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Divine Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 27 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:8010 https://api.deepseek.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../divine-server/bin/": "bin/"
    },
    "icon": [
      "icons/64x64.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
