{
  "name": "divine-app",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "tsc -b && vite build --mode prod",
    "build:test": "tsc -b && vite build --mode test",
    "i18n:extract": "i18next-cli extract",
    "i18n:tw": "node scripts/convert-zh-tw.mjs",
    "i18n:check": "i18next-cli extract --ci --dry-run && i18next-cli status",
    "i18n:status": "i18next-cli status",
    "preview": "vite preview --mode prod",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --config src-tauri/tauri.prod.conf.json",
    "tauri:build:debug": "tauri build --debug --config src-tauri/tauri.test.conf.json --features devtools",
    "tauri:build:prod": "tauri build --config src-tauri/tauri.prod.conf.json",
    "tauri:build:test": "tauri build --config src-tauri/tauri.test.conf.json --features devtools --no-sign"
  },
  "dependencies": {
    "@shikijs/langs": "^4.4.3",
    "@shikijs/stream": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "echarts": "^6.1.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "thinking-orbs": "^0.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "i18next-cli": "^1.69.0",
    "less": "^4.8.1",
    "opencc-js": "^1.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
