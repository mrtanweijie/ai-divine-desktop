{
  "name": "divine-app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build --mode prod",
    "build:test": "tsc -b && vite build --mode test",
    "i18n:extract": "i18next-cli extract",
    "i18n:tw": "node scripts/convert-zh-tw.mjs",
    "i18n:check": "i18next-cli extract --ci --dry-run && i18next-cli status",
    "i18n:status": "i18next-cli status",
    "preview": "vite preview --mode prod",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --config src-tauri/tauri.prod.conf.json",
    "tauri:build:debug": "tauri build --debug --config src-tauri/tauri.test.conf.json --features devtools",
    "tauri:build:prod": "tauri build --config src-tauri/tauri.prod.conf.json",
    "tauri:build:test": "tauri build --config src-tauri/tauri.test.conf.json --features devtools --no-sign",
    "prepare": "git config core.hooksPath divine-app/.husky 2>/dev/null || true"
  },
  "dependencies": {
    "@antv/layout": "^0.3.25",
    "@antv/x6": "^3.0.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/stream": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "echarts": "^6.1.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.61.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "thinking-orbs": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "i18next-cli": "^1.69.0",
    "less": "^4.8.1",
    "lint-staged": "^17.4.1",
    "opencc-js": "^1.4.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mjs}": [
      "prettier --write"
    ]
  }
}
