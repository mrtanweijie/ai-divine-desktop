{
  "name": "divine-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "tsc -b && vite build --mode prod",
    "build:test": "tsc -b && vite build --mode test",
    "preview": "vite preview --mode prod",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --config src-tauri/tauri.prod.conf.json",
    "tauri:build:debug": "tauri build --debug --config src-tauri/tauri.test.conf.json --features devtools",
    "tauri:build:prod": "tauri build --config src-tauri/tauri.prod.conf.json",
    "tauri:build:test": "tauri build --config src-tauri/tauri.test.conf.json --features devtools --no-sign"
  },
  "dependencies": {
    "@shikijs/langs": "^4.4.2",
    "@shikijs/stream": "^4.4.2",
    "@shikijs/themes": "^4.4.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.4",
    "remark-gfm": "^4.0.0",
    "shiki": "^4.4.2",
    "thinking-orbs": "^0.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.1",
    "less": "^4.8.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
